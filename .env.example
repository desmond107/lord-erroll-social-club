# ── Core ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lord_erroll_club?sslmode=require"
APP_URL="https://club.lord-erroll.com"            # public URL; used in emails, QR codes and payment callbacks
AUTH_SECRET=""                                     # openssl rand -base64 32
DATA_ENCRYPTION_KEY=""                             # openssl rand -base64 32  (32 bytes). BACK THIS UP: losing it makes encrypted data unreadable
CRON_SECRET=""                                     # openssl rand -hex 24; the daily job must send "Authorization: Bearer <CRON_SECRET>"
ADMIN_2FA="required"                               # "required" (default) forces every staff account to use an authenticator app
UPLOAD_DIR="/var/lib/lord-erroll/uploads"          # private, persistent, NOT inside /public

# ── M-Pesa Daraja (STK Push) ─────────────────────────────────────────────
MPESA_ENV="production"                             # or "sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""                                 # Paybill or Till (BusinessShortCode)
MPESA_PASSKEY=""
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"     # CustomerBuyGoodsOnline for a Till
MPESA_PARTY_B=""                                   # only for Till numbers if different from the shortcode
MPESA_CALLBACK_SECRET=""                           # openssl rand -hex 16; becomes part of the callback URL
MPESA_CALLBACK_BASE=""                             # optional; defaults to APP_URL
MPESA_ALLOWED_IPS=""                               # optional comma list of Safaricom callback IPs
PAYMENTS_SIMULATE="0"                              # "1" enables the M-Pesa simulator; ignored in production

# ── Card payments (Paystack, KES) ────────────────────────────────────────
PAYSTACK_SECRET_KEY=""                             # webhook URL: <APP_URL>/api/payments/paystack/webhook

# ── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="The Lord Erroll Social Club <membership@lord-erroll.com>"
EMAIL_REPLY_TO="reservations@lord-erroll.com"
ADMIN_NOTIFY_EMAILS=""                             # comma list; told about new applications and data requests

# ── SMS: Africa's Talking (preferred) or Twilio ──────────────────────────
AT_USERNAME=""
AT_API_KEY=""
AT_SENDER_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
PAID_MESSAGES_HOURLY_CAP="500"

# ── WhatsApp (Meta Cloud API) ────────────────────────────────────────────
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE="club_notice"                    # approved template with one body variable {{1}}

# ── CAPTCHA (Cloudflare Turnstile) ───────────────────────────────────────
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Virus scanning (ClamAV daemon) ───────────────────────────────────────
CLAMAV_HOST=""
CLAMAV_PORT="3310"
CLAMAV_REQUIRED="1"                                # refuse uploads in production if the scanner is down
